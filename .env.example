# Обязательно: ключ Gemini из Google AI Studio
GEMINI_API_KEY=

# Необязательно: ключ Serper для поиска в интернете.
# Без него обычные ответы Gemini работают, но свежие данные не ищутся.
SERPER_API_KEY=

# Необязательно: модель Gemini. Можно указывать как с префиксом models/, так и без.
GEMINI_MODEL=gemini-3.5-flash-lite

# Необязательно: часовой пояс для даты и времени в ответах.
TIME_ZONE=Europe/Moscow

# Необязательно: ID навыка из Яндекс Диалогов.
# Если задать, вебхук будет принимать запросы только от этого навыка.
YANDEX_SKILL_ID=
